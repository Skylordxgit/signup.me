# Copy this file to .env.local for local development, or configure these
# as environment variables in Hostinger for production.

# MySQL connection string. Leave unset locally to use the built-in JSON file
# store (data/db.json). Required in production.
# Format: mysql://db_user:db_password@db_host:3306/db_name
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_MIN=5
DB_POOL_MAX=30

# Redis Cache & Queue for extreme high concurrency (10,000–30,000+ users).
# When configured, public landing pages and custom domain routing are served
# directly from Redis/Memory with zero MySQL queries, and analytics are batched.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Real server-side IP geolocation. Download MaxMind GeoLite2 City separately
# under your MaxMind license and point this to the readable .mmdb file.
# Do not commit the database file to Git.
GEOIP_DB_PATH=/absolute/path/GeoLite2-City.mmdb

# Fallback when no local GeoLite2 database is available: set to 1 to resolve
# country/region/city via the free ipwho.is HTTP API (no key needed).
# Lookups have a 2.5s timeout and are cached 12h; a failing provider never
# blocks subscriptions. Leave blank/0 to keep the previous behavior
# (CDN headers only, city/region stay "Unknown").
GEOIP_HTTP_FALLBACK=1

# Optional: set only when your trusted reverse proxy overwrites this header.
# Leave blank to use Cloudflare CF-Connecting-IP, X-Real-IP, then X-Forwarded-For.
CLIENT_IP_HEADER=

# Long random value used to sign admin session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin login credentials for the platform Master Admin.
# When set, logging in with these credentials grants universal Master Admin
# access: every workspace can be entered with full rights, with no team
# membership, invitation or permission grant required.
#
# The password may be written as a plain password (easiest in a hosting panel)
# or as a salted scrypt hash. A plain password is hashed before it is stored in
# the database, so no plain password is ever persisted.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Public base URL. Public page links are generated as {slug}.your-domain.com.
# For local subdomain testing, use http://localhost:3002.
NEXT_PUBLIC_APP_URL=

# Set to "true" in production so session cookies require HTTPS.
COOKIE_SECURE=false

# With MySQL configured, image bytes and metadata are saved in media_files.
# This directory is used for local disk storage and finding legacy uploads.
# Opening Media imports surviving legacy files into MySQL automatically.
# Without MySQL, use a persistent directory outside the deploy folder.
# Defaults to data/uploads. Public URLs remain /uploads/<category>/<name>.
UPLOAD_DIR=

# Maximum accepted upload size in bytes (default 5MB). Images are compressed
# and resized in the browser before upload, so this applies to the final file.
MAX_UPLOAD_BYTES=

# Browser push notifications. Generate a pair with:
# node -e "const webpush=require('web-push'); console.log(webpush.generateVAPIDKeys())"
# Use the same public key in both public variables so the browser and server agree.
WEB_PUSH_CONTACT=mailto:admin@signup888.shop
WEB_PUSH_PUBLIC_KEY=
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Optional subscriber metadata. Set only to headers your trusted hosting proxy
# OVERWRITES (not appends or passes through). IP must contain a single IPv4/IPv6.
# Leave blank until Hostinger confirms its headers; missing data is Not recorded.
# Never use an arbitrary client-supplied X-Forwarded-For chain here.
SUBSCRIBER_IP_HEADER=
SUBSCRIBER_COUNTRY_HEADER=
SUBSCRIBER_CITY_HEADER=

# Custom-domain DNS verification. Prefer a CNAME target; otherwise configure
# the public server IPv4 address. The API also returns an optional www
# record using the same target. SSL status is recorded separately and no
# certificate is issued by this application.
CUSTOM_DOMAIN_CNAME_TARGET=
CUSTOM_DOMAIN_SERVER_IP=

# Hostnames reserved for the master control plane and default application.
MASTER_ADMIN_DOMAIN=
DEFAULT_APP_DOMAIN=
